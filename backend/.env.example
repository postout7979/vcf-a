# VCF Automation (VCF 9) connection - base URL only, no trailing path
VCF_AUTOMATION_BASE_URL=https://vcfa.example.local

# --- Provider plane (also used to obtain org tokens - no per-org token needed) ---
# Option A: provider user + password  (logs in as <user>@system)
VCF_AUTOMATION_USERNAME=admin
VCF_AUTOMATION_PASSWORD=change-me
VCF_PROVIDER_ORG_NAME=system
# Option B: provider API token (takes precedence if set)
VCF_PROVIDER_REFRESH_TOKEN=

# Optional: only sync these orgs (comma-separated). Empty = every org.
VCF_ORG_ALLOWLIST=

# Optional fallback: per-org API tokens (JSON on ONE line, single-quoted).
# Used for an org only when listed here; otherwise the provider->org exchange is used.
VCF_ORG_TOKENS=
VCF_AUTOMATION_REFRESH_TOKEN=
# Optional: override the OIDC relying party clientId (auto-detected by default)
VCF_RELYING_PARTY_CLIENT_ID=

# Restrict catalog sync to a specific Project (optional, leave blank for all)
VCF_AUTOMATION_PROJECT_ID=

# Set to false for self-signed/internal CA certs
VCF_VERIFY_TLS=true

# Auto-sync interval in minutes (default: 60)
SYNC_INTERVAL_MINUTES=60

# SQLite DB path.
# - Local/dev (venv):   sqlite:///./vcf_portal.db
# - Docker (see docker-compose.yml, /app/data is a mounted volume):
#     sqlite:////app/data/vcf_portal.db
DATABASE_URL=sqlite:///./vcf_portal.db

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
